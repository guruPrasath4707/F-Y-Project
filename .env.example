# Keep real credentials in .env or your hosting provider's server-side environment.
# Do not use VITE_GROQ_API_KEY: Vite variables with the VITE_ prefix are public.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=mistral-saba-24b
PORT=3001
# Set HOST=0.0.0.0 only when your deployment platform needs an external bind address.
# HOST=0.0.0.0
