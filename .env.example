# Keep real credentials in .env or your hosting provider's server-side environment.
# Do not use VITE_GROQ_API_KEY: Vite variables with the VITE_ prefix are public.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
PORT=3001
# Auth is disabled during local development unless AUTH_REQUIRED=true.
# NODE_ENV=production enables authentication and requires both values below.
# AUTH_REQUIRED=true
# APP_ACCESS_PASSWORD=use-a-unique-password-at-least-12-characters
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
# Set HOST=0.0.0.0 only when your deployment platform needs an external bind address.
# HOST=0.0.0.0
